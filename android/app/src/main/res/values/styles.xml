<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash: obsidian background with the teal shield, no white flash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#06080C</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">#0B0D12</item>
        <item name="android:navigationBarColor">#06080C</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <color name="ic_launcher_background">#0B0D12</color>
    <color name="cyber_teal">#14B8A6</color>
    <color name="cyber_amber">#F59E0B</color>
    <color name="obsidian">#0B0D12</color>
</resources>
